{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/digest",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/geocode",
      "schedule": "30 2 * * *"
    }
  ]
}
